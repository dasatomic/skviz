# zavisnosti i lokalno
node_modules/
.env
*.log
.DS_Store
.claude/

# preuzeti udžbenici (tuđa autorska prava, ~700 MB) – ne objavljuju se
izvori/

# lični podaci i stanje igre (imena igrača, istorija odigranih pitanja)
podaci/statistika.json
podaci/odigrana-pitanja.json
# telemetrija za /admin (SQLite, lib/telemetrija.js)
podaci/telemetrija.db*
# ključ za javne id-jeve igrača i sobe sačuvane pri gašenju servera (deploy bez prekida igre)
podaci/kljuc-id
podaci/sobe.json
# privremene datoteke bezbednog upisa (lib/upis.js)
podaci/*.tmp

# Python keš (alati/manim)
__pycache__/

# slike ličnosti za bonus rundu (keš, preuzimaju se sa Wikimedia Commons)
podaci/bonus-slike/
